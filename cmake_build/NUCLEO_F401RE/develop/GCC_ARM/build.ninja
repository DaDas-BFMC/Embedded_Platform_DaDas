  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\trieu\Documents\Gitlab\Embedded_Platform_DaDas\cmake_build\NUCLEO_F401RE\develop\GCC_ARM\mbed-os\cmsis\device\rtos && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build mbed-os/cmsis/device/rtos/install/strip: phony mbed-os/cmsis/device/rtos/CMakeFiles/install/strip.util

